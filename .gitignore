.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Keep these committed on purpose:
#   uv.lock, frontend/package-lock.json, templates/**/package-lock.json
#   .python-version, pyproject.toml
#   static/react/  (prebuilt UI so `uv run python run.py` works immediately)
#   templates/**/.env.example  (placeholders, never real secrets)
#
# Ignore nested template repo metadata only if one is left in place. A nested
# .git directory should be deleted instead, otherwise git adds that template
# as a broken submodule/gitlink rather than committing its source files.
templates/**/.git/
