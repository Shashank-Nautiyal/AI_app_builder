# Routing: openrouter | groq | cerebras | mistral | nvidia | deepinfra | felo | fireworks
LLM_PROVIDER=openrouter

# Provider keys. Only the provider selected above is required.
OPENROUTER_API_KEY=your-openrouter-key
GROQ_API_KEY=your-groq-key
CEREBRAS_API_KEY=your-cerebras-key
MISTRAL_API_KEY=your-mistral-key
NVIDIA_API_KEY=your-nvidia-key
DEEPINFRA_API_TOKEN=your-deepinfra-token
FELO_API_KEY=your-felo-key
FIREWORKS_API_KEY=your-fireworks-key
OPENAI_API_KEY=your-openai-key
HF_TOKEN=your-huggingface-token

# Optional services
GITHUB_TOKEN=your-github-token

# Optional runtime overrides
# HOST=127.0.0.1
# PORT=8000
# UVICORN_RELOAD=0
# PROJECTS_DATABASE_URL=sqlite:///./projects.db
# DB_PATH=./pipeline_checkpoints.db

# Optional model overrides
# OPENROUTER_PLANNER_MODEL=openai/gpt-4o-mini
# OPENROUTER_CODER_MODEL=qwen/qwen3-coder
# LLM_MAX_OUTPUT_TOKENS=4096
